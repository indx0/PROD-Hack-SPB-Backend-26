DB_URL=jdbc:postgresql://localhost:5432/prod_backend
DB_USERNAME=app
DB_PASSWORD=app

#Generate with "openssl rand -base64 32"
SECRET_KEY=jwt_secret_key

ADMIN_PASSWORD=adminpassword
USER1_PASSWORD=userpassword

# Optional: photo inventory. Without a key only recognition returns 503.
LLM_PROXY_API_KEY=
LLM_PROXY_URL=https://llm-proxy.spirit.t-education.com/chat/completions
LLM_PROXY_MODEL=openai/gpt-6-luna
LLM_PROXY_CONNECT_TIMEOUT_MS=10000
LLM_PROXY_TIMEOUT_MS=120000
# Independent random secret for Prometheus scraping; empty disables access.
METRICS_SCRAPE_TOKEN=
OBSERVABILITY_ENVIRONMENT=prod

